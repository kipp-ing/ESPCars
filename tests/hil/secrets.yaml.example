# Copy to tests/hil/secrets.yaml and fill in. `secrets.yaml` is gitignored at every level
# (see .gitignore), this example file is not — so never put real credentials here.
#
# Only the WiFi rigs need this (wifi_probe.yaml and anything including it). Every other bench
# config runs with the radio off and needs no secrets at all.
wifi_ssid: "your-bench-ssid"
wifi_password: "your-bench-password"
